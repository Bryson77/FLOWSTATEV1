{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saktus-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "flowstateproductivity.xyz",
      "custom_domain": true
    },
    {
      "pattern": "www.flowstateproductivity.xyz",
      "custom_domain": true
    },
    {
      "pattern": "app.flowstateproductivity.xyz",
      "custom_domain": true
    }
  ]
}
