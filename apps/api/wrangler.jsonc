{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flowstate-api",
  "main": "dist/index.js",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "tail_consumers": [
    { "service": "alerts-tail" }
  ]
}
