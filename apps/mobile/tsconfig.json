{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@flowstate/study-engine": ["../../lib/study-engine/src/index.ts"],
      "@flowstate/shared": ["../../lib/shared/src/index.ts"]
    },
    "tsBuildInfoFile": ".turbo/tsconfig.tsbuildinfo"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
