{
  "expo": {
    "name": "Saktus",
    "slug": "kestra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "saktus",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saktus.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.saktus.app"
    },
    "plugins": ["expo-router", "expo-font"],
    "extra": {
      "eas": {
        "projectId": "6f650258-7ddc-4e76-9f7d-f63f573b5744"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6f650258-7ddc-4e76-9f7d-f63f573b5744"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
